---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import About from '../../components/About.astro';
import Services from '../../components/Services.astro';
import Portfolio from '../../components/Portfolio.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { cs } from '../../i18n/cs';
---

<Layout title={cs.meta.title} description={cs.meta.description} lang="cs" ogImage={cs.meta.ogImage}>
  <Nav t={cs.nav} locale="cs" />
  <main>
    <Hero t={cs.hero} locale="cs" />
    <About t={cs.about} />
    <Services t={cs.services} locale="cs" />
    <Portfolio t={cs.portfolio} />
    <Contact t={cs.contact} />
  </main>
  <Footer t={cs.footer} />
</Layout>
